])}while(1);</x>{"success":true,"payload":{"value":{"id":"cfee4427e8b6","versionId":"91c760ee967f","creatorId":"bcdde4d906c5","homeCollectionId":"","title":"A better way to share photos…","detectedLanguage":"en","latestVersion":"91c760ee967f","latestPublishedVersion":"91c760ee967f","hasUnpublishedEdits":false,"latestRev":303,"createdAt":1615673725372,"updatedAt":1641568407933,"acceptedAt":0,"firstPublishedAt":1615686570623,"latestPublishedAt":1615686570623,"vote":false,"experimentalCss":"","displayAuthor":"","content":{"subtitle":"Point your camera at a screen to share to it!","bodyModel":{"paragraphs":[{"name":"c671","type":3,"text":"A better way to share photos…","markups":[]},{"name":"6d14","type":4,"text":"cred. @thebakinghobbyist","markups":[{"type":3,"start":6,"end":24,"href":"https://www.instagram.com/thebakinghobbyist/","title":"","rel":"","anchorType":0}],"layout":1,"metadata":{"id":"1*e-pXtW1zDQFKE75cKZC7ow.png","originalWidth":1079,"originalHeight":1081}},{"name":"0d77","type":1,"text":"Picture this. You’ve just baked some awesome macarons and want to share your creation. After meticulously adjusting the lighting, you use your smartphone to take a great shot. Now all you need to do is touch it up in Photoshop and you’ll be ready to show it to the world.","markups":[]},{"name":"076e","type":1,"text":"You click the share button and now need to decide between the lesser of 3 evils:","markups":[]},{"name":"3656","type":4,"text":"","markups":[],"layout":1,"metadata":{"id":"1*3L7jBJZYzxFW68jbsMabYQ.png","originalWidth":799,"originalHeight":319}},{"name":"55f3","type":13,"text":"Bluetooth","markups":[]},{"name":"17f0","type":9,"text":"Not every desktop supports this","markups":[]},{"name":"7d53","type":9,"text":"Clunky to pair","markups":[]},{"name":"1d92","type":9,"text":"Slow","markups":[{"type":1,"start":0,"end":4}]},{"name":"5a5d","type":13,"text":"Messenger","markups":[]},{"name":"c578","type":9,"text":"Facebook","markups":[]},{"name":"255b","type":13,"text":"Gmail","markups":[]},{"name":"f5c7","type":9,"text":"Uses up Google Drive storage","markups":[]},{"name":"476a","type":9,"text":"Cumbersome to deal with large files + multiple pictures","markups":[]},{"name":"890a","type":1,"text":"There must be a better way…","markups":[]},{"name":"c8e9","type":4,"text":"Ever since I was a kid, I’ve been fascinated by Iron Man’s tech. This scene in particular is the inspiration behind this project.","markups":[],"layout":1,"metadata":{"id":"1*nxH_q3wGJuC6xpVovrg8iw.gif","originalWidth":520,"originalHeight":292,"isFeatured":true}},{"name":"1106","type":6,"text":"Why can’t we just point our phones at a screen, and share data directly to (the PC behind) that screen?","markups":[]},{"name":"7e1e","type":3,"text":"Introducing CamShare!","markups":[]},{"name":"a209","type":11,"text":"","markups":[],"layout":3,"iframe":{"mediaResourceId":"3528ba046a386bd07d6ae29a7070a7fe","iframeWidth":854,"iframeHeight":480}},{"name":"a189","type":1,"text":"Share any file directly to CamShare, point your camera at the device you want to share to, and the file automatically ends up in your Downloads folder!","markups":[{"type":1,"start":27,"end":35}]},{"name":"1143","type":9,"text":"Faster than Bluetooth (uses Wi-Fi)","markups":[]},{"name":"6da0","type":9,"text":"Setup is completely within your LAN; meaning you control your data","markups":[]},{"name":"7bd0","type":9,"text":"Ephemeral storage","markups":[]},{"name":"3b53","type":9,"text":"Platform agnostic (Android/iOS -> Windows/Mac/Linux/…)","markups":[]},{"name":"4268","type":4,"text":"","markups":[],"layout":1,"metadata":{"id":"1*-FtBtSOy1wsGdnRhUJY8Mw.gif","originalWidth":245,"originalHeight":150}}],"sections":[{"name":"c8c9","startIndex":0}]},"postDisplay":{"coverless":true}},"virtuals":{"allowNotes":true,"previewImage":{"imageId":"1*nxH_q3wGJuC6xpVovrg8iw.gif","filter":"","backgroundSize":"","originalWidth":520,"originalHeight":292,"strategy":"resample","height":0,"width":0},"wordCount":178,"ima